# Single source of truth for toolchain and tool versions.
#
# Read by the Makefile (include), by scripts/ (. ./versions.env) and by the
# GitHub workflows (appended to $GITHUB_ENV). Format: KEY=value lines, #
# comments, no quotes and no spaces around "=".
#
# Update policy: pick the newest stable release published at least 14 days
# earlier, recompute every SHA-256 from the downloaded artifact, and update the
# pinned action SHAs in .github/workflows/ in the same change.

# Supported Go toolchains: the two most recent major releases.
GO_VERSION_OLDEST=1.26
GO_VERSION_NEWEST=1.27

# Linter used by the local gates and the pull request workflow.
GOLANGCI_LINT_VERSION=v2.14.0

# API compatibility checker (golang.org/x/exp/cmd/gorelease, untagged module).
GORELEASE_VERSION=v0.0.0-20260824195058-e88cd73687aa

# Security scanners, pinned by version and by the SHA-256 of the linux/amd64 tarball.
TRIVY_VERSION=0.75.0
TRIVY_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
BEARER_VERSION=2.1.1
BEARER_SHA256=6b79d315577fea8305dfe08577bea6ad53852a929cd24de9211d39750a194bbb
SEMGREP_IMAGE=semgrep/semgrep:1.178.0@sha256:32e459968daabe7ab86968184a29109b9564aa00392401156f9788452b42786b
